import 'package:flutter/widgets.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:tests_app/counter.dart';

void main() {
  group('counter', () {
    group('next', () {
      test('adds two', () {
        expect(next(1), 3);
      });

      test('throws', () {
        throw StateError('the counter broke');
      });
    });
  });

  testWidgets('shows other text', (tester) async {
    await tester.pumpWidget(
      const Directionality(
        textDirection: TextDirection.ltr,
        child: Text('hello'),
      ),
    );
    expect(find.text('goodbye'), findsOneWidget);
  });

  testWidgets('widget throws', (tester) async {
    throw ArgumentError('bad widget');
  });

  test('skipped one', () {
    expect(1, 2);
  }, skip: 'not now');
}
