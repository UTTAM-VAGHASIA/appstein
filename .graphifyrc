# graphify settings for this repo, read by `graphify hook install`
# (run through `fvm dart run tool/install_hooks.dart`).
#
# graphify draws single nodes in graph.html only up to 5,000 nodes and shows
# a community summary above that. This repo's graph passed 5,000 nodes in
# slice 1b.4, so the limit is raised to keep the full view.
viz_node_limit=10000
